{
  "info": {
    "_postman_id": "c1d2e3f4-a5b6-7890-cdef-bd-users-grpc",
    "name": "BD Management · bd-users · CreateBdAccount / UpdateBdAccount",
    "description": "bd-management 内部 gRPC 创建/编辑账号 + HTTP 效果验收。\n\n**场景矩阵**：`docs/bd-users-grpc-testing.md`\n\n| 目录 | 覆盖 |\n|------|------|\n| A | HTTP Manager 创建 BD / 禁止 Manager |\n| B | gRPC CreateBdAccount 后 HTTP 登录 + /me |\n| C | gRPC UpdateBdAccount 改名 / login_disabled |\n| D | HTTP 不可编辑 Manager |\n\n**先跑**：`./scripts/bd-grpc-account-scenarios.sh`（写入 `grpcCreated*`）\n\n**运行**：`npm run pm:bd-users-grpc:local`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiBase", "value": "http://127.0.0.1:8080" },
    { "key": "managerEmail", "value": "mgr.global@zoomex.com" },
    { "key": "managerPassword", "value": "Passw0rd" },
    { "key": "managerToken", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "loginData", "value": "" },
    { "key": "grpcCreatedEmail", "value": "" },
    { "key": "grpcCreatedPassword", "value": "Passw0rd" },
    { "key": "grpcCreatedUserId", "value": "" },
    { "key": "grpcCreatedName", "value": "" },
    { "key": "grpcUpdatedName", "value": "" },
    { "key": "grpcLoginDisabled", "value": "0" },
    { "key": "_httpCreatedBdId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "  pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}",
          "const name = (pm.info && pm.info.requestName) || '';",
          "const url = pm.request.url.toString();",
          "// gRPC 验收（CA-/UA-）与 /me 用 accessToken；仅 Setup + HTTP Manager 写操作用 managerToken",
          "const isGrpcEffect = /\\b(CA-|UA-)\\d/.test(name);",
          "const useManager = !isGrpcEffect && (",
          "  /S01 Manager 登录/.test(name) ||",
          "  (/\\[ok\\] H-|\\[err\\] H-E/.test(name) && /\\/api\\/v1\\/bd-users/.test(url))",
          ");",
          "const token = useManager",
          "  ? (pm.environment.get('managerToken') || pm.collectionVariables.get('managerToken') || '')",
          "  : (pm.environment.get('accessToken') || pm.collectionVariables.get('accessToken') || '');",
          "const needsAuth = /\\/bd-users|\\/logout|\\/change_password/i.test(url) && !/login/.test(url);",
          "if (needsAuth && token && !/无\\s*Token|无\\s*auth/i.test(name)) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token.trim() });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const ct = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
          "const text = pm.response.text() || '';",
          "if (ct.includes('text/html') || text.trimStart().startsWith('<!')) {",
          "  pm.test('响应应为 JSON API', () => pm.expect.fail('got HTML'));",
          "  return;",
          "}",
          "try {",
          "  const body = pm.response.json();",
          "  if (body && body.ret_code === 0 && typeof body.token === 'string' && body.token) {",
          "    const n = (pm.info && pm.info.requestName) || '';",
          "    if (/Manager 登录|S01/.test(n)) {",
          "      pm.environment.set('managerToken', body.token);",
          "      pm.collectionVariables.set('managerToken', body.token);",
          "    } else {",
          "      pm.environment.set('accessToken', body.token);",
          "      pm.collectionVariables.set('accessToken', body.token);",
          "    }",
          "  }",
          "} catch (e) { /* ignore */ }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "S01 Manager 登录 mgr.global@zoomex.com",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.environment.get('managerEmail') || pm.collectionVariables.get('managerEmail');",
                  "const password = pm.environment.get('managerPassword') || pm.collectionVariables.get('managerPassword');",
                  "const brokerId = pm.environment.get('brokerId') || '1';",
                  "const plain = JSON.stringify({ email, password, broker_id: Number(brokerId) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "pm.test('Manager token 非空', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.eql('');",
                  "});",
                  "pm.collectionVariables.set('managerToken', body.token);",
                  "pm.environment.set('managerToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        }
      ]
    },
    {
      "name": "A · HTTP Manager 创建 BD [ok]",
      "item": [
        {
          "name": "[ok] H-01 POST /bd-users 创建本区域 BD",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "const body = {",
                  "  name: 'BD HTTP ' + ts,",
                  "  email: 'bd.http.' + ts + '@zoomex.com',",
                  "  role: 'bd',",
                  "  region: 'non_kr',",
                  "  initial_password: 'Passw0rd'",
                  "};",
                  "pm.collectionVariables.set('_createBdBody', JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "const r = body.result || {};",
                  "pm.test('CreateBdUserResp 字段', () => {",
                  "  pm.expect(r).to.include.keys('user_id', 'user_role', 'region', 'initial_password');",
                  "  pm.expect(r.user_role).to.eql('BD');",
                  "  pm.expect(r.region).to.eql('NON_KR');",
                  "});",
                  "pm.collectionVariables.set('_httpCreatedBdId', String(r.user_id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{_createBdBody}}"
            },
            "url": "{{apiBase}}/api/v1/bd-users"
          }
        },
        {
          "name": "[ok] H-02 GET /bd-users 列表含 BD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "const r = body.result || {};",
                  "pm.test('分页结构', () => {",
                  "  pm.expect(r).to.include.keys('list', 'total', 'page', 'page_size');",
                  "  pm.expect(r.list).to.be.an('array');",
                  "});",
                  "if (r.list.length > 0) {",
                  "  pm.test('列表项为 BD', () => {",
                  "    r.list.forEach(i => pm.expect(i.user_role || i.role).to.be.oneOf(['BD', 'bd']));",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/v1/bd-users?page=1&page_size=20&region=non_kr",
              "host": ["{{apiBase}}"],
              "path": ["api", "v1", "bd-users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "region", "value": "non_kr" }
              ]
            }
          }
        },
        {
          "name": "[err] H-E01 HTTP 禁止创建 Manager",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('_createBdBody', JSON.stringify({",
                  "  name: 'Mgr HTTP',",
                  "  email: 'mgr.http.' + ts + '@zoomex.com',",
                  "  role: 'manager',",
                  "  region: 'kr',",
                  "  initial_password: 'Passw0rd'",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=10005 permission denied', () => pm.expect(body.ret_code).to.eql(10005));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{_createBdBody}}"
            },
            "url": "{{apiBase}}/api/v1/bd-users"
          }
        }
      ]
    },
    {
      "name": "B · gRPC CreateBdAccount HTTP 验收",
      "description": "先执行 `./scripts/bd-grpc-account-scenarios.sh` 写入 grpcCreated*。",
      "item": [
        {
          "name": "[ok] CA-02 gRPC 创建账号可登录",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = (pm.environment.get('grpcCreatedEmail') || pm.collectionVariables.get('grpcCreatedEmail') || '').trim();",
                  "const password = (pm.environment.get('grpcCreatedPassword') || pm.collectionVariables.get('grpcCreatedPassword') || 'Passw0rd').trim();",
                  "const brokerId = pm.environment.get('brokerId') || '1';",
                  "if (!email) {",
                  "  pm.collectionVariables.set('_skipGrpc', 'true');",
                  "  pm.collectionVariables.set('loginData', JSON.stringify('{}'));",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('_skipGrpc', 'false');",
                  "const plain = JSON.stringify({ email, password, broker_id: Number(brokerId) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipGrpc') === 'true') {",
                  "  pm.test('未跑 gRPC 场景脚本 — skip CA-02（先执行 bd-grpc-account-scenarios.sh）', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "if (pm.collectionVariables.get('grpcLoginDisabled') === '1') {",
                  "  pm.test('账号处于 login_disabled=1 — skip 登录正例', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "pm.collectionVariables.set('accessToken', body.token);",
                  "pm.environment.set('accessToken', body.token);",
                  "pm.collectionVariables.set('_grpcUserLoggedIn', 'true');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        },
        {
          "name": "[ok] CA-03 GET /bd-users/me 校验 Manager 角色",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipGrpc') === 'true') {",
                  "  pm.test('skip CA-03', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "if (pm.collectionVariables.get('_grpcUserLoggedIn') !== 'true') {",
                  "  pm.test('CA-02 未登录 gRPC 账号 — skip CA-03', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "const r = body.result || {};",
                  "const expectedEmail = (pm.environment.get('grpcCreatedEmail') || pm.collectionVariables.get('grpcCreatedEmail') || '').toLowerCase();",
                  "const userRole = r.user_role || r.userRole;",
                  "pm.test('BdUserItem 角色/邮箱', () => {",
                  "  pm.expect(r).to.have.property('id');",
                  "  pm.expect(r).to.have.property('email');",
                  "  pm.expect(userRole).to.eql('MANAGER_KR');",
                  "  pm.expect(r.role).to.eql('manager');",
                  "  if (expectedEmail) pm.expect(String(r.email).toLowerCase()).to.eql(expectedEmail);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/bd-users/me"
          }
        }
      ]
    },
    {
      "name": "C · gRPC UpdateBdAccount HTTP 验收",
      "item": [
        {
          "name": "[ok] UA-03 GET /me 改名生效",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = (pm.environment.get('grpcCreatedEmail') || '').trim();",
                  "const password = (pm.environment.get('grpcCreatedPassword') || 'Passw0rd').trim();",
                  "if (!email) { pm.collectionVariables.set('_skipGrpc', 'true'); return; }",
                  "pm.collectionVariables.set('_skipGrpc', 'false');",
                  "const plain = JSON.stringify({ email, password, broker_id: Number(pm.environment.get('brokerId') || 1) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipGrpc') === 'true') {",
                  "  pm.test('skip UA-03 login', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.ret_code !== 0) {",
                  "  pm.test('需 grpcLoginDisabled=0 且脚本已恢复登录', () => pm.expect.fail('login ret_code=' + body.ret_code));",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('accessToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        },
        {
          "name": "[ok] UA-03b /me name 为 grpcUpdatedName",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipGrpc') === 'true') {",
                  "  pm.test('skip UA-03b', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "const expected = pm.environment.get('grpcUpdatedName') || pm.collectionVariables.get('grpcUpdatedName');",
                  "if (expected) {",
                  "  pm.test('改名生效', () => pm.expect(body.result.name).to.eql(expected));",
                  "} else {",
                  "  pm.test('未设置 grpcUpdatedName — 仅校验 name 存在', () => {",
                  "    pm.expect(body.result.name).to.be.a('string').and.not.eql('');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/bd-users/me"
          }
        },
        {
          "name": "[err] UA-02 login_disabled=1 时登录失败",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = (pm.environment.get('grpcCreatedEmail') || '').trim();",
                  "const password = (pm.environment.get('grpcCreatedPassword') || 'Passw0rd').trim();",
                  "const disabled = pm.environment.get('grpcLoginDisabled') || '0';",
                  "if (!email || disabled !== '1') {",
                  "  pm.collectionVariables.set('_skipDisabled', 'true');",
                  "  const plain = JSON.stringify({ email: email || 'skip@x.com', password, broker_id: 1 });",
                  "  pm.collectionVariables.set('loginData', JSON.stringify(plain));",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('_skipDisabled', 'false');",
                  "// 脚本末尾会恢复 login_disabled=0；本用例需在恢复前单独跑 update --login-disabled 1",
                  "const plain = JSON.stringify({ email, password, broker_id: Number(pm.environment.get('brokerId') || 1) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipDisabled') === 'true') {",
                  "  pm.test('grpcLoginDisabled≠1 — skip UA-02（可手动 update --login-disabled 1 后重跑）', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=20102 LOGIN_DISABLED', () => pm.expect(body.ret_code).to.eql(20102));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        }
      ]
    },
    {
      "name": "D · HTTP 权限边界 [err]",
      "item": [
        {
          "name": "[err] H-E02 HTTP 不可编辑 Manager 账号",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = (pm.environment.get('grpcCreatedUserId') || pm.collectionVariables.get('grpcCreatedUserId') || '').trim();",
                  "if (!id) {",
                  "  pm.collectionVariables.set('_skipEdit', 'true');",
                  "  pm.request.url = pm.request.url.toString().replace('{{grpcCreatedUserId}}', '0');",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('_skipEdit', 'false');",
                  "pm.collectionVariables.set('_updateBody', JSON.stringify({ name: 'HTTP should fail' }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipEdit') === 'true') {",
                  "  pm.test('无 grpcCreatedUserId — skip H-E02', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=10005', () => pm.expect(body.ret_code).to.eql(10005));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{_updateBody}}"
            },
            "url": "{{apiBase}}/api/v1/bd-users/{{grpcCreatedUserId}}"
          }
        }
      ]
    }
  ]
}
