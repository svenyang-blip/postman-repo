    {
      "name": "03 Commission Setting · Override",
      "description": "POST `/affiliate/commission_setting/override`",
      "item": [
        {
          "name": "O01 POST override 成功（需可操作用 share）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.ret_code === 0 && body.result) {",
                  "  pm.collectionVariables.set('_hasOperableShare', 'true');",
                  "  pm.collectionVariables.set('_overrideOk', 'true');",
                  "  const r = body.result;",
                  "  pm.test('AdminOpResult 结构', () => {",
                  "    pm.expect(r).to.include.keys(",
                  "      'action', 'affiliation_id', 'share_id',",
                  "      'rate_before_e6', 'rate_after_e6', 'display_status'",
                  "    );",
                  "    pm.expect(r.action).to.eql('override');",
                  "    pm.expect(r.display_status).to.eql('overridden');",
                  "    pm.expect(r.rate_after_e6).to.eql(Number(pm.collectionVariables.get('overrideRateE6')));",
                  "  });",
                  "  if (r.share_id) pm.collectionVariables.set('shareRelatedId', String(r.share_id));",
                  "} else {",
                  "  pm.collectionVariables.set('_overrideOk', 'false');",
                  "  pm.test('无可操作 share（ret_code=3）— 停用用例将跳过', () => {",
                  "    pm.expect(body.ret_code).to.eql(3);",
                  "  });",
                  "}"
                ]
              }
            }
