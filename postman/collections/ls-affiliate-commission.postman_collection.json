        {
          "name": "P-U01 POST commission_profile Upsert 开启+50%",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_gatewayUnauthorized') === 'true') {",
                  "  pm.test('跳过业务断言（Cookie 已生效，网关 403 Unauthorized）', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
