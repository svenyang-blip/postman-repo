                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"affiliation_id\": {{affiliationId}},\n  \"self_serve_enabled\": {{_origSelfServeEnabled}},\n  \"max_commission_rate_e6\": {{_origMaxRateE6}},\n  \"remark\": \"postman restore profile\"\n}"
            },
            "url": "{{apiBase}}/affiliate/commission_profile"
          }
        }
      ]
    },
    {
      "name": "02 Commission Setting · Logs",
      "description": "GET `/affiliate/commission_setting/logs`",
      "item": [
        {
          "name": "L01 GET logs 按 affiliation_id 分页",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "const r = body.result;",
                  "pm.test('CommissionSettingLogListResp 结构', () => {",
                  "  pm.expect(r).to.include.keys('list', 'page', 'page_size', 'total');",
                  "  pm.expect(r.list).to.be.an('array');",
                  "  pm.expect(r.page).to.eql(1);",
                  "  pm.expect(r.page_size).to.eql(10);",
