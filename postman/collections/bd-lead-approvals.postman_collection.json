                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "const r = body.result || {};",
                  "pm.test('分页结构', () => {",
                  "  pm.expect(r).to.include.keys(\"list\", \"total\", \"page\", \"page_size\");",
                  "  pm.expect(r.list).to.be.an('array');",
                  "});",
                  "pm.test('result.page=1', () => pm.expect(r..page).to.eql(1));",
                  "pm.test('result.page_size=20', () => pm.expect(r..page_size).to.eql(20));",
                  "pm.test('result.list 为数组', () => pm.expect(r..list).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/leads/approvals"
          }
