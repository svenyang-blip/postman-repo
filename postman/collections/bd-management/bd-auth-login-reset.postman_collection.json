            "url": "{{apiBase}}/api/v1/bd-users/ping"
          }
        },
        {
          "name": "[ok] F-01c logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{apiBase}}/api/v1/logout"
          }
        },
        {
          "name": "[err] F-01d logout 后再 ping",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const old = pm.collectionVariables.get('_oldToken') || '';",
                  "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + old });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('已登出鉴权失败', () => {",
                  "  pm.expect(body.ret_code).to.not.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/bd-users/ping"
          }
        },
        {
          "name": "[ok] F-02a 登录（改密前）",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.environment.get('bdEmail');",
                  "const password = pm.environment.get('bdPassword');",
                  "const brokerId = pm.environment.get('brokerId') || '1';",
                  "const plain = JSON.stringify({ email, password, broker_id: Number(brokerId) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "pm.collectionVariables.set('accessToken', body.token);",
                  "pm.environment.set('accessToken', body.token);",
                  "pm.collectionVariables.set('_oldToken', body.token);",
                  "const np = 'Chg' + String(Date.now()).slice(-6) + 'Aa1';",
                  "pm.collectionVariables.set('_newPassword', np);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        },
        {
          "name": "[ok] F-02b change_password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const oldPwd = pm.environment.get('bdPassword');",
                  "const newPwd = pm.collectionVariables.get('_newPassword');",
                  "if (!newPwd) throw new Error('缺少 _newPassword');",
                  "pm.collectionVariables.set('_changeBody', JSON.stringify({",
                  "  old_password: oldPwd,",
                  "  new_password: newPwd",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
