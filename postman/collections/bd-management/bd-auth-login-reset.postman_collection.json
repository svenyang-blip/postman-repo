    {
      "name": "C · ResetPassword 效果 [ok]",
      "description": "先执行 scripts/bd-grpc-reset-password.sh（R-01），再用临时密码登录验收 R-02 / L-03。未重置则 skip。",
      "item": [
        {
          "name": "[ok] R-02/L-03 重置后登录 mustChangePassword=true",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = (pm.environment.get('bdEmail') || '').trim();",
                  "const temp = (pm.environment.get('tempPassword') || '').trim();",
                  "const userId = (pm.environment.get('bdUserId') || '').trim();",
                  "const brokerId = pm.environment.get('brokerId') || '1';",
                  "if (!email || !temp || !userId) {",
                  "  pm.collectionVariables.set('_skipReset', 'true');",
                  "  const plain = JSON.stringify({ email: email || 'skip@example.com', password: 'SkipPass1', broker_id: Number(brokerId) });",
                  "  pm.collectionVariables.set('loginData', JSON.stringify(plain));",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('_skipReset', 'false');",
                  "const plain = JSON.stringify({ email, password: temp, broker_id: Number(brokerId) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipReset') === 'true') {",
                  "  pm.test('未配置 bdUserId/tempPassword 或未先 gRPC 重置 — skip R-02', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.ret_code !== 0) {",
                  "  pm.test('重置后可用 tempPassword 登录（请先跑 bd-grpc-reset-password.sh）', () => {",
                  "    pm.expect.fail('ret_code=' + body.ret_code + ' msg=' + body.ret_msg);",
                  "  });",
                  "  return;",
                  "}",
                  "pm.test('ret_code=0', () => pm.expect(body.ret_code).to.eql(0));",
                  "pm.test('mustChangePassword=true', () => {",
                  "  pm.expect(body.result.mustChangePassword).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.token);",
                  "pm.environment.set('accessToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        },
        {
          "name": "[ok] R-03 旧 JWT 在重置后失效（可选）",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const old = (pm.collectionVariables.get('_oldTokenBeforeReset') || '').trim();",
                  "if (!old) {",
                  "  pm.collectionVariables.set('_skipOld', 'true');",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('_skipOld', 'false');",
                  "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + old });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_skipOld') === 'true') {",
                  "  pm.test('未缓存 _oldTokenBeforeReset — skip R-03（可在重置前手动 set）', () => pm.expect(true).to.eql(true));",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('旧 token 鉴权失败', () => {",
                  "  pm.expect(body.ret_code).to.be.oneOf([10007, 20100, 20104, 20101]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/bd-users/ping"
          }
        }
      ]
    },
