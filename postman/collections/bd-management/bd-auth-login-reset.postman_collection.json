        {
          "name": "[ok] F-02d 新密登录并恢复原密码",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.environment.get('bdEmail');",
                  "const newPwd = pm.collectionVariables.get('_newPassword');",
                  "const brokerId = pm.environment.get('brokerId') || '1';",
                  "const plain = JSON.stringify({ email, password: newPwd, broker_id: Number(brokerId) });",
                  "pm.collectionVariables.set('loginData', JSON.stringify(plain));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('新密登录成功', () => pm.expect(body.ret_code).to.eql(0));",
                  "pm.test('mustChangePassword=false', () => {",
                  "  pm.expect(body.result.mustChangePassword).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.token);",
                  "pm.environment.set('accessToken', body.token);",
                  "",
                  "// 恢复环境原密码，避免污染后续跑次",
                  "const orig = pm.environment.get('bdPassword');",
                  "const cur = pm.collectionVariables.get('_newPassword');",
                  "pm.sendRequest({",
                  "  url: (pm.environment.get('apiBase') || pm.collectionVariables.get('apiBase')) + '/api/v1/change_password',",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Content-Type': 'application/json',",
                  "    Authorization: 'Bearer ' + body.token",
                  "  },",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({ old_password: cur, new_password: orig })",
                  "  }",
                  "}, (err, res) => {",
                  "  pm.test('已尝试恢复原密码', () => {",
                  "    pm.expect(err).to.eql(null);",
                  "    if (res) pm.expect(res.code).to.eql(200);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{loginData}},\n  \"broker_id\": {{brokerId}}\n}"
            },
            "url": "{{apiBase}}/api/v1/login"
          }
        }
