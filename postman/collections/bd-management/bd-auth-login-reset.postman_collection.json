              "raw": "{{_changeBody}}"
            },
            "url": "{{apiBase}}/api/v1/change_password"
          }
        },
        {
          "name": "[err] F-02c 旧 token ping 应失败",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const old = pm.collectionVariables.get('_oldToken') || '';",
                  "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + old });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('改密后旧 token 失效', () => pm.expect(body.ret_code).to.not.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/bd-users/ping"
          }
