{
  "name": "postman-repo",
  "private": true,
  "description": "Postman / Newman 集合：PM testnet event list demo",
  "scripts": {
    "pm:event-list": "newman run postman/collections/prediction-market/pm-ce-testnet-event-list.postman_collection.json --reporters cli",
    "pm:admin-sync": "newman run postman/collections/prediction-market/pm-admin-sync-controller.postman_collection.json -e postman/environments/pm-admin-testnet.private.postman_environment.json --reporters cli",
    "pm:admin-sync:local": "newman run postman/collections/prediction-market/pm-admin-sync-controller.postman_collection.json -e postman/environments/pm-admin-local.postman_environment.json --reporters cli",
    "pm:admin-sync:testnet": "npm run pm:admin-sync",
    "pm:admin-instant-product:local": "newman run postman/collections/prediction-market/pm-admin-instant-product-controller.postman_collection.json -e postman/environments/pm-admin-local.postman_environment.json --reporters cli",
    "pm:admin-instant-product:testnet": "newman run postman/collections/prediction-market/pm-admin-instant-product-controller.postman_collection.json -e postman/environments/pm-admin-testnet.private.postman_environment.json --reporters cli",
    "pm:ce-updown:local": "newman run postman/collections/prediction-market/pm-ce-updown-local.postman_collection.json -e postman/environments/pm-ce-local.postman_environment.json --reporters cli",
    "pm:ls-affiliate-commission:testnet": "newman run postman/collections/ls-affiliate/ls-affiliate-commission.postman_collection.json -e postman/environments/ls-affiliate-mp-testnet.private.postman_environment.json --reporters cli",
    "pm:one-commission-settings:local": "newman run postman/collections/one-portal/one-portal-commission-settings.postman_collection.json -e postman/environments/one-portal-local.postman_environment.json --reporters cli",
    "pm:one-commission-settings:testnet": "newman run postman/collections/one-portal/one-portal-commission-settings.postman_collection.json -e postman/environments/one-portal-testnet.private.postman_environment.json --reporters cli",
    "pm:bd-auth:local": "newman run postman/collections/bd-management/bd-auth-login-reset.postman_collection.json -e postman/environments/bd-management-local.postman_environment.json --reporters cli",
    "pm:bd-users-grpc:local": "./scripts/bd-grpc-account-scenarios.sh && newman run postman/collections/bd-management/bd-bd-users-grpc.postman_collection.json -e postman/environments/bd-management-local.postman_environment.json --reporters cli",
    "pm:bd-users-grpc:http-only": "newman run postman/collections/bd-management/bd-bd-users-grpc.postman_collection.json -e postman/environments/bd-management-local.postman_environment.json --reporters cli",
    "pm:skeleton:compile": "node scripts/yaml-to-postman.mjs",
    "pm:bd-approvals:local": "npm run pm:skeleton:compile && newman run postman/collections/bd-management/bd-lead-approvals.postman_collection.json -e postman/environments/bd-management-local.postman_environment.json --reporters cli",
    "pm:bd-okr:local": "npm run pm:skeleton:compile && newman run postman/collections/bd-management/bd-okr.postman_collection.json -e postman/environments/bd-management-local.postman_environment.json --reporters cli",
    "pm:bd-okr:testnet": "npm run pm:skeleton:compile && newman run postman/collections/bd-management/bd-okr.postman_collection.json -e postman/environments/bd-management-testnet.private.postman_environment.json --reporters cli",
    "pm:bd-api:local": "newman run postman/collections/bd-management/bd-api-testnet.postman_collection.json -e postman/environments/bd-management-local.postman_environment.json --reporters cli",
    "pm:bd-api:testnet": "newman run postman/collections/bd-management/bd-api-testnet.postman_collection.json -e postman/environments/bd-management-testnet.private.postman_environment.json --reporters cli"
  },
  "devDependencies": {
    "js-yaml": "^4.3.1",
    "newman": "^6.2.1"
  }
}
